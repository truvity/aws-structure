{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:eu-west-1:777777777777:parameter/acme/router/auth",
        "arn:aws:ssm:eu-west-1:777777777777:parameter/acme/router/key"
      ]
    },
    {
      "Sid": "ReadObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::acme-config/router/config/<sha256>.conf"
      ]
    },
    {
      "Sid": "OwnGroup",
      "Effect": "Allow",
      "Action": [
        "autoscaling:CompleteLifecycleAction",
        "autoscaling:SetInstanceHealth"
      ],
      "Resource": [
        "arn:aws:autoscaling:eu-west-1:777777777777:autoScalingGroup:*:autoScalingGroupName/router"
      ]
    }
  ]
}
