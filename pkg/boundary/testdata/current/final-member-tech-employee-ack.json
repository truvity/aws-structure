{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowIAMRead",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowCreateWorkloadRole",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": [
        "arn:part:iam::*:role/${aws:PrincipalTag/cluster}-${aws:PrincipalTag/project}.*"
      ],
      "Condition": {
        "ArnLike": {
          "iam:PermissionsBoundary": "arn:part:iam::*:policy/bound@tech-project-workload"
        },
        "StringEquals": {
          "aws:RequestTag/cluster": "${aws:PrincipalTag/cluster}",
          "aws:RequestTag/project": "${aws:PrincipalTag/project}"
        }
      }
    },
    {
      "Sid": "AllowSetWorkloadBoundary",
      "Effect": "Allow",
      "Action": "iam:PutRolePermissionsBoundary",
      "Resource": [
        "arn:part:iam::*:role/${aws:PrincipalTag/cluster}-${aws:PrincipalTag/project}.*"
      ],
      "Condition": {
        "ArnLike": {
          "iam:PermissionsBoundary": "arn:part:iam::*:policy/bound@tech-project-workload"
        },
        "StringEquals": {
          "aws:ResourceTag/project": "${aws:PrincipalTag/project}"
        }
      }
    },
    {
      "Sid": "AllowManageOwnRole",
      "Effect": "Allow",
      "Action": [
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:part:iam::*:role/${aws:PrincipalTag/cluster}-${aws:PrincipalTag/project}.*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/project": "${aws:PrincipalTag/project}"
        }
      }
    },
    {
      "Sid": "AllowAttachOwnPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:part:iam::*:role/${aws:PrincipalTag/cluster}-${aws:PrincipalTag/project}.*"
      ],
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": [
            "arn:part:iam::*:policy/${aws:PrincipalTag/cluster}-${aws:PrincipalTag/project}.*"
          ]
        },
        "StringEquals": {
          "aws:ResourceTag/project": "${aws:PrincipalTag/project}"
        }
      }
    },
    {
      "Sid": "AllowManageOwnPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:part:iam::*:policy/${aws:PrincipalTag/cluster}-${aws:PrincipalTag/project}.*"
      ]
    },
    {
      "Sid": "AllowPassOwnRoleToPodIdentity",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:part:iam::*:role/${aws:PrincipalTag/cluster}-${aws:PrincipalTag/project}.*"
      ],
      "Condition": {
        "StringEqualsIfExists": {
          "iam:PassedToService": "pods.eks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowPodIdentityAssociations",
      "Effect": "Allow",
      "Action": [
        "eks:CreatePodIdentityAssociation",
        "eks:DeletePodIdentityAssociation",
        "eks:DescribePodIdentityAssociation",
        "eks:UpdatePodIdentityAssociation",
        "eks:ListPodIdentityAssociations",
        "eks:TagResource",
        "eks:UntagResource"
      ],
      "Resource": [
        "arn:part:eks:*:*:cluster/${aws:PrincipalTag/cluster}",
        "arn:part:eks:*:*:podidentityassociation/${aws:PrincipalTag/cluster}/*"
      ]
    },
    {
      "Sid": "AllowOwnBucketAdmin",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucket*",
        "s3:PutBucket*",
        "s3:DeleteBucket*",
        "s3:Get*Configuration",
        "s3:Put*Configuration"
      ],
      "Resource": [
        "arn:part:s3:::acme-${aws:PrincipalTag/cluster}-${aws:PrincipalTag/project}-*"
      ]
    },
    {
      "Sid": "AllowBucketList",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "AllowCreateKey",
      "Effect": "Allow",
      "Action": "kms:CreateKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/project": "${aws:PrincipalTag/project}"
        }
      }
    },
    {
      "Sid": "AllowManageOwnKey",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags",
        "kms:ListKeyPolicies",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:UpdateKeyDescription",
        "kms:EnableKey",
        "kms:EnableKeyRotation",
        "kms:DisableKeyRotation",
        "kms:CreateAlias",
        "kms:UpdateAlias",
        "kms:DeleteAlias"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/project": "${aws:PrincipalTag/project}"
        }
      }
    },
    {
      "Sid": "AllowOwnAlias",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias",
        "kms:UpdateAlias",
        "kms:DeleteAlias"
      ],
      "Resource": "arn:part:kms:*:*:alias/${aws:PrincipalTag/cluster}-${aws:PrincipalTag/project}-*"
    },
    {
      "Sid": "AllowKeyList",
      "Effect": "Allow",
      "Action": [
        "kms:ListAliases",
        "kms:ListKeys"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyRetagProjectOrCluster",
      "Effect": "Deny",
      "Action": [
        "iam:TagRole",
        "iam:CreateRole"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:RequestTag/project": "false"
        },
        "StringNotEquals": {
          "aws:RequestTag/project": "${aws:PrincipalTag/project}"
        }
      }
    },
    {
      "Sid": "DenyRetagClusterTag",
      "Effect": "Deny",
      "Action": [
        "iam:TagRole",
        "iam:CreateRole"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:RequestTag/cluster": "false"
        },
        "StringNotEquals": {
          "aws:RequestTag/cluster": "${aws:PrincipalTag/cluster}"
        }
      }
    },
    {
      "Sid": "DenyUntagProjectOrCluster",
      "Effect": "Deny",
      "Action": "iam:UntagRole",
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "project",
            "cluster"
          ]
        }
      }
    },
    {
      "Sid": "DenyKeyRetirement",
      "Effect": "Deny",
      "Action": [
        "kms:ScheduleKeyDeletion",
        "kms:DisableKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyBoundaryPolicyEdit",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": [
        "arn:part:iam::*:policy/bound@*"
      ]
    },
    {
      "Sid": "NoBoundaryDelete",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:DeleteUserPermissionsBoundary"
      ],
      "Resource": "*"
    }
  ]
}
