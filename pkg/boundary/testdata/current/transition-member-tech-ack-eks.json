{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPodIdentityAssociations",
      "Effect": "Allow",
      "Action": [
        "eks:CreatePodIdentityAssociation",
        "eks:DeletePodIdentityAssociation",
        "eks:DescribePodIdentityAssociation",
        "eks:UpdatePodIdentityAssociation",
        "eks:ListPodIdentityAssociations",
        "eks:TagResource",
        "eks:UntagResource"
      ],
      "Resource": [
        "arn:part:eks:*:*:cluster/*",
        "arn:part:eks:*:*:podidentityassociation/*/*"
      ]
    },
    {
      "Sid": "AllowPassPlatformRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:part:iam::*:role/*-db-*",
        "arn:part:iam::*:role/*-lab-*"
      ],
      "Condition": {
        "StringEqualsIfExists": {
          "iam:PassedToService": "pods.eks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AllowRoleRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:part:iam::*:role/*"
    },
    {
      "Sid": "AllowAssumeProjectBuilders",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Resource": [
        "arn:part:iam::*:role/*-builder-*",
        "arn:part:iam::*:role/*-sandbox-*"
      ]
    },
    {
      "Sid": "DenyBoundaryPolicyEdit",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": [
        "arn:part:iam::*:policy/bound@*"
      ]
    },
    {
      "Sid": "NoBoundaryDelete",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:DeleteUserPermissionsBoundary"
      ],
      "Resource": "*"
    }
  ]
}
