{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAll",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "AllowOrganizationAdmin",
      "Effect": "Allow",
      "Action": [
        "organizations:*",
        "account:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowBoundaryPolicyEdit",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": [
        "arn:part:iam::*:policy/bound@*"
      ]
    },
    {
      "Sid": "DenyChangePermissionsSetsRoles",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription"
      ],
      "Resource": "arn:part:iam::*:role/AWSServiceRoleFor*"
    },
    {
      "Sid": "DenyCreateOrChangeWithoutBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary",
        "iam:CreateUser",
        "iam:PutUserPermissionsBoundary"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "iam:PermissionsBoundary": [
            "arn:part:iam::*:policy/bound@role-admin",
            "arn:part:iam::*:policy/bound@role-deployer",
            "arn:part:iam::*:policy/bound@role-auditor",
            "arn:part:iam::*:policy/bound@default",
            "arn:part:iam::*:policy/bound@tech-ack-iam",
            "arn:part:iam::*:policy/bound@tech-ack-eks",
            "arn:part:iam::*:policy/bound@tech-ack-s3",
            "arn:part:iam::*:policy/bound@tech-ack-kms",
            "arn:part:iam::*:policy/bound@tech-ack-dynamodb",
            "arn:part:iam::*:policy/bound@tech-project-ack",
            "arn:part:iam::*:policy/bound@tech-employee-ack",
            "arn:part:iam::*:policy/bound@tech-project-workload",
            "arn:part:iam::*:policy/bound@tech-node"
          ]
        }
      }
    },
    {
      "Sid": "NoBoundaryDelete",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:DeleteUserPermissionsBoundary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDestructiveActions",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:DeleteTrail",
        "cloudtrail:StopLogging",
        "ec2:DeleteVpc",
        "kms:DisableKey",
        "kms:ScheduleKeyDeletion",
        "route53:DeleteHostedZone"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDeletePulumiStateBuckets",
      "Effect": "Deny",
      "Action": "s3:DeleteBucket",
      "Resource": "arn:part:s3:::pulumi-state-*"
    }
  ]
}
